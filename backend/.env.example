# Copy to backend/.env and fill in. Never commit the real .env.
# Supabase > Project Settings > Database > Connection string (URI, "Transaction pooler", port 6543)
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Supabase > Project Settings > API (service_role key is secret: server only, never in frontend code)
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images
# Optional alternative to DATABASE_URL:
# MONGO_URL=
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ADMIN_EMAIL=admin@aurevia.com
ADMIN_PASSWORD=change-me

# Razorpay (https://dashboard.razorpay.com/app/keys). Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production: true behind HTTPS
COOKIE_SECURE=false
