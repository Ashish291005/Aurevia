# Copy to backend/.env and fill in. Never commit the real .env.
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=aurevia
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ADMIN_EMAIL=admin@aurevia.com
ADMIN_PASSWORD=change-me

# Razorpay (https://dashboard.razorpay.com/app/keys). Leave empty to offer cash on delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Production: true behind HTTPS
COOKIE_SECURE=false
