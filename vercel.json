{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "admin": {
      "root": "admin",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/admin/(.*)",
          "destination": "/admin/index.html"
        }
      ]
    },
    "aurevia-api": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "server:app"
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "aurevia-api"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "aurevia-api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
